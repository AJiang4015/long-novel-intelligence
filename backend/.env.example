# 配置模板：复制为 backend/.env 后填写（.env 已被 gitignore，不会提交）
# 使用：cp backend/.env.example backend/.env

# 阿里百炼（DashScope OpenAI 兼容模式）——必填
BAILIAN_API_KEY=sk-your-api-key-here
BAILIAN_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 模型：任选你有额度的模型。注意：模型是 eval 基线身份（compare_identity）的一部分，换模型需重建基线
BAILIAN_MODEL=deepseek-v4-flash-0731
LLM_CONCURRENCY=4
CHUNK_SIZE=4000
CHUNK_OVERLAP=400

# Neo4j（与 docker-compose.yml 本地开发默认一致；公开部署请修改密码）
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=12345678

# 可选（默认值如下，留空即默认）
# ER_CHECKPOINT_ENABLED=true      # P19 checkpoint/resume 总开关
# ER_LINEAGE=0                    # P06 lineage 观测（1 开启，旁路零侵入）
